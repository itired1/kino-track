# Порт сервера
PORT=3000

# Подключение к базе данных PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/kino_app

# Или отдельные параметры:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kino_app
DB_USER=postgres
DB_PASSWORD=your_password

# Kinopoisk API ключ (получить на https://kinopoisk.dev/)
KINOPOISK_API_KEY=your_kinopoisk_api_key

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token

# URL фронтенда (для CORS)
FRONTEND_URL=https://your-frontend-url.com

# Node окружение
NODE_ENV=development
