# Порт сервера (Render задаст автоматически)
PORT=3000

# Kinopoisk API ключ (получить на https://kinopoisk.dev/)
KINOPOISK_API_KEY=your_kinopoisk_api_key

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token

# URL фронтенда (для CORS)
FRONTEND_URL=https://kino-frontend.vercel.app
WEB_APP_URL=https://kino-frontend.vercel.app

# Node окружение
NODE_ENV=production